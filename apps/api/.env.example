APP_ENV=development
APP_NAME=OpenHands SaaS API
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWKS_URL=
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=
SUPABASE_TIMEOUT_SECONDS=5
REDIS_URL=
AGENT_SERVER_URL=
AGENT_SERVER_API_KEY=
AGENT_SERVER_WORKSPACE_ROOT=/workspace
REDIS_URL=redis://localhost:6379/0

# Storage (private buckets: org-files, conversation-exports, run-artifacts)
MAX_UPLOAD_BYTES=52428800
STORAGE_SIGNED_URL_TTL_SECONDS=600

# AI Gateway (server-only). Credentials/base URLs are JSON objects keyed by
# provider id, e.g. AI_PROVIDER_CREDENTIALS={"openrouter":"sk-..."}
AI_PROVIDER_CREDENTIALS={}
AI_PROVIDER_BASE_URLS={}
AI_GATEWAY_TIMEOUT_SECONDS=60
AI_GATEWAY_CREDITS_PER_1K_TOKENS=1

# GitHub App (never a shared personal access token)
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=
GITHUB_API_BASE_URL=https://api.github.com

# Billing (optional; leave empty to keep the provider disabled)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_IDS={}
BILLING_SUCCESS_URL=
BILLING_CANCEL_URL=
